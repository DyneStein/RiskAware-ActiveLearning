# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# --- OS -------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Model checkpoints ----------------------------------------------------
# 2.6 GB across 36 experiments (54-97 MB each). GitHub warns above 50 MB per
# file and rejects above 100 MB, and keeping them in normal git history would
# make the repository painful to clone for no benefit -- they are binary, so
# every version is stored in full.
#
# They ARE tracked, just not here: their SHA-256 checksums and sizes are
# recorded in MANIFEST.csv (committed), and the files themselves are published
# as Release assets and mirrored with a DOI at submission. See HOW_TO_RUN.txt.
results/checkpoints/
*.pt
*.pth

# --- Dataset --------------------------------------------------------------
# HAM10000 is ~2.8 GB and licensed CC BY-NC, which is incompatible with this
# repository's MIT licence -- so none of its images are redistributed here,
# including the 490 seed images. What IS committed is the seed image-ID list
# ("Seed Data/seed_metadata.csv"), which is enough to reconstruct the exact
# starting set from any copy of HAM10000. See HOW_TO_RUN.txt to download it.
archive/
*.zip
HAM10000_images_part_*/
Seed Data/*.jpg

# --- Scratch --------------------------------------------------------------
scratch/
tmp/
*.log
